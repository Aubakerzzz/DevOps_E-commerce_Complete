{{/*
Generate the chart name.

- Uses nameOverride if provided in values.yaml.
- Otherwise, uses the chart name defined in Chart.yaml.
- Truncates the name to 63 characters to comply with Kubernetes naming limits.
- Removes a trailing hyphen, if present.
*/}}
{{- define "leyo.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}


{{/*
Generate the full name for Kubernetes resources.

- If fullnameOverride is provided in values.yaml, use it.
- Otherwise, use the name generated by the "leyo.name" helper.
- Truncates the result to 63 characters.
- Removes a trailing hyphen, if present.

This helper can be reused in templates to give resources
a consistent name.
*/}}
{{- define "leyo.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s" (include "leyo.name" .) | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}


{{/*
Generate common Kubernetes labels.

- app.kubernetes.io/name: The application name.
- app.kubernetes.io/instance: The Helm release name.
- app.kubernetes.io/managed-by: The tool managing the release, usually Helm.
- helm.sh/chart: The chart name and version.
  Replaces "+" with "_" to ensure label compatibility.

These labels can be reused across Kubernetes resources
such as Deployments, Services, and ConfigMaps.
*/}}
{{- define "leyo.labels" -}}
app.kubernetes.io/name: {{ include "leyo.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
helm.sh/chart: {{ .Chart.Name }}-{{ .Chart.Version | replace "+" "_" }}
{{- end -}}