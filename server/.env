# ── Server ────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB (matches mongo service in docker-compose) ──
# "mongo" = Docker DNS name of the mongo:7 container
MONGODB_URI=mongodb://mongo:27017/leyo

# ── CORS ──────────────────────────────────────────
# Your index.js reads process.env.FRONTEND_URL for the deployed frontend.
# In Docker you access the client at http://localhost:8080 (see compose ports).
FRONTEND_URL=http://localhost:8080

# ── Auth (used by user.controller.js for JWT cookies) ──
# Your route/user.route.js almost certainly signs JWTs with these.
# Generate strong random values — do NOT commit this file.
ACCESS_TOKEN_SECRET=JHBHJBFEJKNEKJFNEJKBRFJKBNNMJBHBSDFEHWFJ
REFRESH_TOKEN_SECRET=JHBHJBFEJKNEKJFNEJKBRFJKBNNMJBHBSDFEHWFJ
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# # ── Uploads (used by upload.router.js / Cloudinary) ──
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# # ── Stripe (if order.route.js uses it) ──
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Client (consumed at BUILD time by Vite in ./client) ──
# NOTE: this is NOT read by server code. It's listed here for completeness.
# Vite only bakes VITE_* vars into the client at build time. The client's
# Dockerfile must receive it as a build arg, or you set it in client/.env.
VITE_API_URL=http://localhost:5000